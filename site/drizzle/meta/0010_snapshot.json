        "realm_trial_fee": {
          "name": "realm_trial_fee",
          "value": "(\"realm_trials\".\"from_realm\" = 'qi' AND \"realm_trials\".\"target_realm\" = 'foundation' AND \"realm_trials\".\"fee\" = 500) OR (\"realm_trials\".\"from_realm\" = 'foundation' AND \"realm_trials\".\"target_realm\" = 'core' AND \"realm_trials\".\"fee\" = 2000)"
        },
        "realm_trial_base": {
          "name": "realm_trial_base",
          "value": "length(\"realm_trials\".\"base_commit\") = 40"
        },
        "realm_trial_state": {
          "name": "realm_trial_state",
          "value": "\"realm_trials\".\"state\" IN ('active', 'passed', 'expired', 'withdrawn', 'failed', 'platform_failure')"
        },
        "realm_trial_expiry": {
          "name": "realm_trial_expiry",
          "value": "\"realm_trials\".\"expires_at\" > \"realm_trials\".\"started_at\""
        },
        "realm_trial_finish": {
          "name": "realm_trial_finish",
          "value": "(\"realm_trials\".\"state\" = 'active' AND \"realm_trials\".\"finished_at\" IS NULL AND \"realm_trials\".\"finish_reason\" IS NULL) OR (\"realm_trials\".\"state\" != 'active' AND \"realm_trials\".\"finished_at\" >= \"realm_trials\".\"started_at\" AND length(\"realm_trials\".\"finish_reason\") BETWEEN 1 AND 500)"
        }
      }
    },
